{
  "name": "it-tools-markdown-table-formatter-plugin",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:e2e:desktop": "playwright test",
    "build": "node plugin/build.mjs",
    "typecheck": "node --check plugin/build.mjs && node --check scripts/stage-plugin.mjs",
    "stage": "node scripts/stage-plugin.mjs",
    "test:wasm": "node --test tests/wasm.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
